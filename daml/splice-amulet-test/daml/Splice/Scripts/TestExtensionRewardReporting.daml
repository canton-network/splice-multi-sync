-- | PoC (extension reward reporting): a registered synchronizer's operator reports its per-round
--   activity on the decentralized synchronizer as a Merkle root-hash commitment plus total, the
--   DSO party starts reward processing with an issuance rate, and the operator expands its
--   committed batches into `RewardCouponV2` contracts (amount = activity weight * rate).
--
--   The registration vote plumbing is exercised elsewhere; here the registration and the
--   reporting state are created directly as the DSO party and the start-processing choice is
--   exercised directly, to isolate the reporting and expansion mechanics.
module Splice.Scripts.TestExtensionRewardReporting where

import DA.Assert
import DA.Foldable (forA_)
import qualified DA.Set as Set
import DA.Time

import Daml.Script

import Splice.Amulet (RewardCouponV2(..))
import Splice.Amulet.CryptoHash qualified as CryptoHash
import Splice.Amulet.RewardAccountingV2
import Splice.AmuletRules
import Splice.DecentralizedSynchronizer
import Splice.Types (Round(..))

import Splice.Scripts.Util

testSyncId : Text
testSyncId = "registered-sync::1220fafafafafafafafafafafafafafafafafafafafafafafafafafafafafafa"

-- | Everything the tests need after an operator has reported: the app, the parties, the
--   on-ledger report, and the committed tree (root + both leaves).
data ReportedActivitySetup = ReportedActivitySetup with
    app : AmuletApp
    operator : Party
    registrationCid : ContractId RegisteredSynchronizer
    featuredA : Party
    featuredB : Party
    reportCid : ContractId ExtensionActivityReport
    root : Batch
    leaf1 : Batch
    leaf2 : Batch

-- | Common setup: an operator with a reporting state, two featured providers, and a two-level
--   batch tree over activity weights (10 + 30 for the providers, 10 for the operator's own cut),
--   reported for round 1.
setupReportedActivity : Script ReportedActivitySetup
setupReportedActivity = do
  d <- setupDefaultAppWithUsers
  let app = d.app
  operator <- allocateParty "registeredSyncOperator"
  featuredA <- allocateParty "featuredAppA"
  featuredB <- allocateParty "featuredAppB"

  registrationCid <- submit app.dso $ createCmd RegisteredSynchronizer with
    dso = app.dso
    synchronizerId = testSyncId
    operator
  stateCid <- submit app.dso $ createCmd DedicatedSynchronizerState with
    dso = app.dso
    synchronizerId = testSyncId
    operator
    lastReportedRound = None
    totalActivityReported = 0.0

  -- the operator's committed tree: leaves are activity weights, not Amulet
  let leaf1 = BatchOfMintingAllowances
        [ MintingAllowance with provider = featuredA; amount = 10.0
        , MintingAllowance with provider = featuredB; amount = 30.0
        ]
      leaf2 = BatchOfMintingAllowances
        [ MintingAllowance with provider = operator; amount = 10.0 ]
      root = BatchOfWeightedBatches
        [ WeightedBatchRef with batchHash = CryptoHash.hash leaf1; weight = 40.0
        , WeightedBatchRef with batchHash = CryptoHash.hash leaf2; weight = 10.0
        ]

  result <- submit operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 1
    activityRootHash = CryptoHash.hash root
    totalActivity = 50.0

  -- the report is on-ledger and the running state advanced
  Some st <- queryContractId app.dso result.stateCid
  st.lastReportedRound === Some (Round 1)
  st.totalActivityReported === 50.0

  pure ReportedActivitySetup with app; operator; registrationCid; featuredA; featuredB; reportCid = result.reportCid; root; leaf1; leaf2

-- | Happy path: report -> start processing at a rate -> operator expands root and leaves ->
--   coupons carry weight * rate.
test_ReportAndExpand : Script ()
test_ReportAndExpand = do
  ReportedActivitySetup{..} <- setupReportedActivity
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso

  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False

  -- the report is consumed; the root ProcessRewardsV2 names the operator as expander
  None <- queryContractId app.dso reportCid
  [(rootCid, rootState)] <- query @ProcessRewardsV2 operator
  rootState.expander === Some operator
  rootState.batchHash === CryptoHash.hash root
  rootState.issuancePerActivityUnit === Some 2.0
  rootState.round === Round 1

  -- operator expands the root, then each leaf (matching contracts by committed hash)
  submit operator $ exerciseCmd rootCid ProcessRewardsV2_ProcessBatch with
    batch = root
    providersWithWrongVettingState = Set.empty
  children <- query @ProcessRewardsV2 operator
  length children === 2
  forA_ children $ \(cid, st) -> do
    let batch = if st.batchHash == CryptoHash.hash leaf1 then leaf1 else leaf2
    CryptoHash.hash batch === st.batchHash
    submit operator $ exerciseCmd cid ProcessRewardsV2_ProcessBatch with
      batch
      providersWithWrongVettingState = Set.empty
  [] <- query @ProcessRewardsV2 operator

  -- coupons mint at weight * rate
  couponsA <- query @RewardCouponV2 featuredA
  map (\(_, c) -> (c.provider, c.amount, c.round)) couponsA === [(featuredA, 20.0, Round 1)]
  couponsB <- query @RewardCouponV2 featuredB
  map (\(_, c) -> c.amount) couponsB === [60.0]
  couponsOp <- query @RewardCouponV2 operator
  map (\(_, c) -> c.amount) couponsOp === [20.0]

-- | Reports must use strictly increasing rounds; totals accumulate across reports.
test_Report_monotonicRounds : Script ()
test_Report_monotonicRounds = do
  ReportedActivitySetup{app, operator} <- setupReportedActivity
  [(stateCid, _)] <- query @DedicatedSynchronizerState operator

  -- same round again: rejected
  submitMustFail operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 1
    activityRootHash = CryptoHash.hash (BatchOfMintingAllowances [])
    totalActivity = 1.0
  -- earlier round: rejected
  submitMustFail operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 0
    activityRootHash = CryptoHash.hash (BatchOfMintingAllowances [])
    totalActivity = 1.0
  -- negative total: rejected
  submitMustFail operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 2
    activityRootHash = CryptoHash.hash (BatchOfMintingAllowances [])
    totalActivity = -1.0
  -- next round: accepted, running total accumulates
  result <- submit operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 2
    activityRootHash = CryptoHash.hash (BatchOfMintingAllowances [])
    totalActivity = 7.0
  Some st <- queryContractId app.dso result.stateCid
  st.lastReportedRound === Some (Round 2)
  st.totalActivityReported === 57.0
  -- only the operator can report
  submitMustFail app.dso $ exerciseCmd result.stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 3
    activityRootHash = CryptoHash.hash (BatchOfMintingAllowances [])
    totalActivity = 1.0

-- | Expansion is bound to the commitment: a tampered batch fails the hash check, and only the
--   expander can process extension batches (the DSO party cannot).
test_Expand_hashAndAuthorization : Script ()
test_Expand_hashAndAuthorization = do
  ReportedActivitySetup{app, operator, registrationCid, featuredA, reportCid, root, leaf1} <- setupReportedActivity
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso

  -- a non-positive rate is rejected up front
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 0.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  -- reported activity above the vote-attested purchased total is rejected
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 49
    rewardCouponTimeToLive = days 30
    dryRun = False

  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  [(rootCid, _)] <- query @ProcessRewardsV2 operator

  -- tampered pre-image: an inflated leaf in place of the committed root fails the hash check
  let tampered = BatchOfMintingAllowances [MintingAllowance with provider = featuredA; amount = 1000000.0]
  submitMustFail operator $ exerciseCmd rootCid ProcessRewardsV2_ProcessBatch with
    batch = tampered
    providersWithWrongVettingState = Set.empty
  -- correct pre-image but wrong controller: the DSO party is not the expander
  submitMustFail app.dso $ exerciseCmd rootCid ProcessRewardsV2_ProcessBatch with
    batch = root
    providersWithWrongVettingState = Set.empty
  -- the committed pre-image from the expander works
  submit operator $ exerciseCmd rootCid ProcessRewardsV2_ProcessBatch with
    batch = root
    providersWithWrongVettingState = Set.empty
  -- a leaf batch cannot be replayed against the other leaf's hash
  children <- query @ProcessRewardsV2 operator
  let Some (wrongCid, _) = find (\(_, st) -> st.batchHash /= CryptoHash.hash leaf1) children
  submitMustFail operator $ exerciseCmd wrongCid ProcessRewardsV2_ProcessBatch with
    batch = leaf1
    providersWithWrongVettingState = Set.empty

-- | Dry run: the whole expansion executes and consumes its contracts without minting coupons.
test_Expand_dryRun : Script ()
test_Expand_dryRun = do
  ReportedActivitySetup{..} <- setupReportedActivity
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = True
  [(rootCid, _)] <- query @ProcessRewardsV2 operator
  submit operator $ exerciseCmd rootCid ProcessRewardsV2_ProcessBatch with
    batch = root
    providersWithWrongVettingState = Set.empty
  children <- query @ProcessRewardsV2 operator
  forA_ children $ \(cid, st) -> do
    let batch = if st.batchHash == CryptoHash.hash leaf1 then leaf1 else leaf2
    submit operator $ exerciseCmd cid ProcessRewardsV2_ProcessBatch with
      batch
      providersWithWrongVettingState = Set.empty
  [] <- query @ProcessRewardsV2 operator
  coupons <- query @RewardCouponV2 featuredA
  coupons === []

-- | The committed tree must sum to exactly the reported total at every level (activity records
--   exist only for reward-eligible providers): over- and under-declarations both fail.
test_Expand_budgetEnforced : Script ()
test_Expand_budgetEnforced = do
  d <- setupDefaultAppWithUsers
  let app = d.app
  operator <- allocateParty "registeredSyncOperator"
  featured <- allocateParty "featuredOverclaimer"
  registrationCid <- submit app.dso $ createCmd RegisteredSynchronizer with
    dso = app.dso
    synchronizerId = testSyncId
    operator
  stateCid <- submit app.dso $ createCmd DedicatedSynchronizerState with
    dso = app.dso
    synchronizerId = testSyncId
    operator
    lastReportedRound = None
    totalActivityReported = 0.0
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso

  -- an internal node declaring more weight than the reported total cannot expand
  let fatLeaf = BatchOfMintingAllowances [MintingAllowance with provider = featured; amount = 500.0]
      overRoot = BatchOfWeightedBatches
        [ WeightedBatchRef with batchHash = CryptoHash.hash fatLeaf; weight = 500.0 ]
  r1 <- submit operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 1
    activityRootHash = CryptoHash.hash overRoot
    totalActivity = 50.0
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid = r1.reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  [(overRootCid, _)] <- query @ProcessRewardsV2 operator
  submitMustFail operator $ exerciseCmd overRootCid ProcessRewardsV2_ProcessBatch with
    batch = overRoot
    providersWithWrongVettingState = Set.empty

  -- a leaf claiming more than the weight its parent declared for it cannot expand
  [(stateCid2, _)] <- query @DedicatedSynchronizerState operator
  let lyingLeaf = BatchOfMintingAllowances [MintingAllowance with provider = featured; amount = 45.0]
      root2 = BatchOfWeightedBatches
        [ WeightedBatchRef with batchHash = CryptoHash.hash lyingLeaf; weight = 40.0 ]
  r2 <- submit operator $ exerciseCmd stateCid2 DedicatedSynchronizerState_ReportActivity with
    round = Round 2
    activityRootHash = CryptoHash.hash root2
    totalActivity = 40.0
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid = r2.reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  prs <- query @ProcessRewardsV2 operator
  let Some (root2Cid, _) = find (\(_, st) -> st.batchHash == CryptoHash.hash root2) prs
  submit operator $ exerciseCmd root2Cid ProcessRewardsV2_ProcessBatch with
    batch = root2
    providersWithWrongVettingState = Set.empty
  prs2 <- query @ProcessRewardsV2 operator
  let Some (leafCid, _) = find (\(_, st) -> st.batchHash == CryptoHash.hash lyingLeaf) prs2
  submitMustFail operator $ exerciseCmd leafCid ProcessRewardsV2_ProcessBatch with
    batch = lyingLeaf
    providersWithWrongVettingState = Set.empty

  -- an internal node declaring less than the reported total cannot expand either
  [(stateCid3, _)] <- query @DedicatedSynchronizerState operator
  let underLeaf = BatchOfMintingAllowances [MintingAllowance with provider = featured; amount = 45.0]
      underRoot = BatchOfWeightedBatches
        [ WeightedBatchRef with batchHash = CryptoHash.hash underLeaf; weight = 45.0 ]
  r3 <- submit operator $ exerciseCmd stateCid3 DedicatedSynchronizerState_ReportActivity with
    round = Round 3
    activityRootHash = CryptoHash.hash underRoot
    totalActivity = 50.0
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid = r3.reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  prs3 <- query @ProcessRewardsV2 operator
  let Some (underRootCid, _) = find (\(_, st) -> st.batchHash == CryptoHash.hash underRoot) prs3
  submitMustFail operator $ exerciseCmd underRootCid ProcessRewardsV2_ProcessBatch with
    batch = underRoot
    providersWithWrongVettingState = Set.empty

  -- a leaf whose contents fall short of its declared weight cannot expand either
  [(stateCid4, _)] <- query @DedicatedSynchronizerState operator
  let shortLeaf = BatchOfMintingAllowances [MintingAllowance with provider = featured; amount = 35.0]
      root4 = BatchOfWeightedBatches
        [ WeightedBatchRef with batchHash = CryptoHash.hash shortLeaf; weight = 40.0 ]
  r4 <- submit operator $ exerciseCmd stateCid4 DedicatedSynchronizerState_ReportActivity with
    round = Round 4
    activityRootHash = CryptoHash.hash root4
    totalActivity = 40.0
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid = r4.reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  prs4 <- query @ProcessRewardsV2 operator
  let Some (root4Cid, _) = find (\(_, st) -> st.batchHash == CryptoHash.hash root4) prs4
  submit operator $ exerciseCmd root4Cid ProcessRewardsV2_ProcessBatch with
    batch = root4
    providersWithWrongVettingState = Set.empty
  prs4b <- query @ProcessRewardsV2 operator
  let Some (shortLeafCid, _) = find (\(_, st) -> st.batchHash == CryptoHash.hash shortLeaf) prs4b
  submitMustFail operator $ exerciseCmd shortLeafCid ProcessRewardsV2_ProcessBatch with
    batch = shortLeaf
    providersWithWrongVettingState = Set.empty

-- | Path exclusivity: unweighted internal nodes are for the decentralized synchronizer only,
--   so an extension tree cannot smuggle weight past the budget through a plain BatchOfBatches.
test_Expand_pathExclusivity : Script ()
test_Expand_pathExclusivity = do
  d <- setupDefaultAppWithUsers
  let app = d.app
  operator <- allocateParty "registeredSyncOperator"
  featured <- allocateParty "featuredAppX"
  registrationCid <- submit app.dso $ createCmd RegisteredSynchronizer with
    dso = app.dso
    synchronizerId = testSyncId
    operator
  stateCid <- submit app.dso $ createCmd DedicatedSynchronizerState with
    dso = app.dso
    synchronizerId = testSyncId
    operator
    lastReportedRound = None
    totalActivityReported = 0.0
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso
  let leaf = BatchOfMintingAllowances [MintingAllowance with provider = featured; amount = 10.0]
      plainRoot = BatchOfBatches [CryptoHash.hash leaf]
  r <- submit operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 1
    activityRootHash = CryptoHash.hash plainRoot
    totalActivity = 10.0
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid = r.reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False
  [(rootCid, _)] <- query @ProcessRewardsV2 operator
  submitMustFail operator $ exerciseCmd rootCid ProcessRewardsV2_ProcessBatch with
    batch = plainRoot
    providersWithWrongVettingState = Set.empty

-- | Start-processing is gated on the live registration: the report must match the
--   registration's synchronizer id AND operator, and an archived (offboarded) registration
--   closes the reward path entirely - leftover reports can never be processed.
test_StartProcessing_registrationGate : Script ()
test_StartProcessing_registrationGate = do
  ReportedActivitySetup{app, operator, registrationCid, reportCid} <- setupReportedActivity
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso
  otherOperator <- allocateParty "otherOperator"

  -- duplicate-registration recovery case: same synchronizer id under another operator
  -- does not authorize processing this operator's report
  dupRegCid <- submit app.dso $ createCmd RegisteredSynchronizer with
    dso = app.dso
    synchronizerId = testSyncId
    operator = otherOperator
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = dupRegCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False

  -- a registration for a different synchronizer does not authorize it either
  otherRegCid <- submit app.dso $ createCmd RegisteredSynchronizer with
    dso = app.dso
    synchronizerId = "registered-sync::1220abababababababababababababababababababababababababababababab"
    operator
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = otherRegCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False

  -- offboarded: with the registration archived, the pending report can never be processed
  submit app.dso $ archiveCmd registrationCid
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 1_000_000
    rewardCouponTimeToLive = days 30
    dryRun = False

-- | The purchased-traffic bound is cumulative: rounds that individually fit cannot
--   together report past what was ever purchased.
test_StartProcessing_cumulativeBound : Script ()
test_StartProcessing_cumulativeBound = do
  ReportedActivitySetup{app, operator, registrationCid, reportCid} <- setupReportedActivity
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso

  -- round 1: 50 reported, lifetime 50 of 80 purchased - processes fine
  submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 80
    rewardCouponTimeToLive = days 30
    dryRun = True

  -- round 2: another 50, individually within 80, but lifetime reported is now 100 of 80
  [(stateCid, _)] <- query @DedicatedSynchronizerState operator
  r2 <- submit operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 2
    activityRootHash = CryptoHash.hash (BatchOfMintingAllowances [])
    totalActivity = 50.0
  submitMustFail app.dso $ exerciseCmd amuletRulesCid AmuletRules_StartProcessingExtensionRewardsV2 with
    reportCid = r2.reportCid
    registeredSynchronizerCid = registrationCid
    issuancePerActivityUnit = 2.0
    purchasedTotal = 80
    rewardCouponTimeToLive = days 30
    dryRun = True
