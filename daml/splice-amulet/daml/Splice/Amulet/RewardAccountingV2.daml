-- | Templates and support code for reward accounting based on off-ledger calculations, as initially
-- described in CIP-104 for traffic-based app rewards.
--
-- It is a Version 2 compared to the previous reward accounting mechanism that is based on tracking
-- all state on-ledger using App|Validator|SvRewardCoupon and IssuingMiningRound contracts.
--
-- The design is flexible to allow for extending it to other kinds of rewards
-- that are based on off-ledger calculations, but the initial implementation is
-- specialized to traffic-based app rewards.
module Splice.Amulet.RewardAccountingV2 where

import DA.Action (unless)
import DA.Foldable (forA_)
import DA.Optional (fromOptional, isNone, isSome, optionalToList)
import DA.Set as Set
import DA.Time

import Splice.Amulet.CryptoHash qualified as CryptoHash
import Splice.Amulet
import Splice.Types
import Splice.Util

-- | State contract tracking the need to calculate and confirm the app reward amounts for the given round.
template CalculateRewardsV2 with
    dso : Party
    round : Round
    roundClosedAt : Time
      -- ^ The time at which the round was closed.
      --
      -- This should be equal to the creation time of this contract.
      -- We store this for ease of doing debugging and gathering metrics.
    rewardCouponTimeToLive : RelTime
      -- ^ Time to live for reward coupons that are created.
      --
      -- We store this as part of requesting the calculation of rewards to avoid reading
      -- the AmuletConfig later again, which could lead to inconsistencies in case of config changes.
    dryRun : Bool
      -- ^ Whether to only simulate the confirmation without creating any RewardCouponV2 contracts.
  where
    signatory dso

-- | A minting allowance for a service provider to mint Amulet.
data MintingAllowance = MintingAllowance with
    provider : Party
    amount : Decimal
  deriving (Eq, Show)

type MintingAllowances = [MintingAllowance]

-- | A child batch reference inside a weighted internal node: the child's hash together with
-- the total activity weight its subtree may mint. The weight is part of the hashed commitment,
-- so it is fixed when the root is reported.
data WeightedBatchRef = WeightedBatchRef with
    batchHash : CryptoHash.Hash
    weight : Decimal
  deriving (Eq, Show)

data Batch
  = BatchOfBatches [CryptoHash.Hash]
  | BatchOfMintingAllowances MintingAllowances
  | BatchOfWeightedBatches [WeightedBatchRef]
    -- ^ Internal node for a registered synchronizer's rewards: expansion checks the declared
    -- child weights against this contract's budget and endows each child with its declared
    -- weight, bounding the whole tree's minting by the reported total.
  deriving (Eq, Show)

data ProcessRewardsV2_ProcessBatchResult = ProcessRewardsV2_ProcessBatchResult {}
  deriving (Eq, Show)

-- | State contract tracking outstanding processing of rewards for a given round and batch hash.
template ProcessRewardsV2 with
    dso : Party
    round : Round
    roundClosedAt : Time
      -- ^ The time at which the round was closed.
      --
      -- Copied from the originating CalculateRewardsV2 contract; for a registered synchronizer's
      -- rewards it is the time processing was started, as the reports carry no round-close time.
      -- We store this for ease of doing debugging and gathering metrics.
    dryRun : Bool -- ^ Whether to only simulate the processing without creating any RewardCouponV2 contracts.
    rewardCouponTimeToLive : RelTime
    batchHash : CryptoHash.Hash
    expander : Optional Party
      -- ^ For a registered synchronizer's rewards (PoC, extension reward reporting): the
      -- synchronizer's operator, the only party holding the committed batch data and thus the
      -- one that processes the batches. `None` for the decentralized synchronizer's own rewards,
      -- which the DSO party processes as before.
    issuancePerActivityUnit : Optional Decimal
      -- ^ For a registered synchronizer's rewards: the issuance rate computed by DSO automation. When set, the
      -- committed batch amounts are activity weights and each coupon mints weight * rate; `None`
      -- means the amounts are Amulet directly, as for the decentralized synchronizer.
    weightBudget : Optional Decimal
      -- ^ For a registered synchronizer's rewards: the activity weight this contract's subtree
      -- may mint, threaded down from the reported round total. Together with the per-level
      -- checks in `ProcessRewardsV2_ProcessBatch` this bounds the total minted by the reported
      -- (and vote-checked) activity. `None` for the decentralized synchronizer's own rewards.
  where
    signatory dso
    -- the expander holds the committed batch data off-ledger and must see these contracts to act
    observer (optionalToList expander)

    choice ProcessRewardsV2_ProcessBatch : ProcessRewardsV2_ProcessBatchResult
      with
        batch : Batch
        providersWithWrongVettingState : Set Party
          -- ^ Service providers that do not have the correct vetting state for receiving rewards.
      observer batchProviders providersWithWrongVettingState batch
      controller fromOptional dso expander
      do
        let actualHash = CryptoHash.hash batch
        require "batch hash matches" (actualHash == batchHash)
        case batch of
          BatchOfBatches batchHashes -> do
            require "unweighted internal nodes are only for decentralized-synchronizer rewards"
              (isNone issuancePerActivityUnit && isNone weightBudget)
            forA_ batchHashes $ \newBatchHash ->
              create ProcessRewardsV2 with
                dso
                round
                roundClosedAt
                rewardCouponTimeToLive
                dryRun
                batchHash = newBatchHash
                expander
                issuancePerActivityUnit
                weightBudget
          BatchOfWeightedBatches weightedRefs -> do
            require "weighted internal nodes are only for registered-synchronizer rewards"
              (isSome issuancePerActivityUnit)
            budget <- case weightBudget of
              Some b -> pure b
              None -> abort "weighted batch without a weight budget"
            require "declared child weights are positive"
              (all (\ref -> ref.weight > 0.0) weightedRefs)
            require "declared child weights are within this subtree's budget"
              (sum (map (\ref -> ref.weight) weightedRefs) <= budget)
            forA_ weightedRefs $ \ref ->
              create ProcessRewardsV2 with
                dso
                round
                roundClosedAt
                rewardCouponTimeToLive
                dryRun
                batchHash = ref.batchHash
                expander
                issuancePerActivityUnit
                weightBudget = Some ref.weight
          BatchOfMintingAllowances mintingAllowances -> do
            forA_ issuancePerActivityUnit $ \_ -> do
              budget <- case weightBudget of
                Some b -> pure b
                None -> abort "weighted leaf without a weight budget"
              require "allowance weights are within this subtree's budget"
                (sum [ ma.amount | ma <- mintingAllowances ] <= budget)
            unless dryRun $ do
              -- Coupon expiry is determined here based on the time of creation to ensure
              -- providers are always given the full rewardCouponTimeToLive duration to redeem their coupons,
              -- independent of how long the processing takes and how many batches there are.
              now <- getTime
              let expiresAt = now `addRelTime` rewardCouponTimeToLive
              forA_ mintingAllowances $ \MintingAllowance{..} ->
                create RewardCouponV2 with
                  dso
                  round
                  provider
                  -- committed amounts are activity weights when an issuance rate is set
                  amount = optional amount (amount *) issuancePerActivityUnit
                  expiresAt
                  providerIsObserver =
                    not $ Set.member provider providersWithWrongVettingState
                  beneficiary = None

        -- intentionally not returning any information here to save computational overhead
        return ProcessRewardsV2_ProcessBatchResult {}

batchProviders : Set Party -> Batch -> [Party]
batchProviders ignoredProviders batch = case batch of
  BatchOfBatches _ -> []
  BatchOfWeightedBatches _ -> []
  BatchOfMintingAllowances mintingAllowances ->
    [ provider | MintingAllowance{..} <- mintingAllowances, not (Set.member provider ignoredProviders) ]


-- instances

instance CryptoHash.Hashable MintingAllowance where
  hash MintingAllowance {provider, amount} =
    CryptoHash.hashRecord [CryptoHash.hash provider , CryptoHash.hash amount]

instance CryptoHash.Hashable WeightedBatchRef where
  hash WeightedBatchRef {batchHash, weight} =
    CryptoHash.hashRecord [CryptoHash.hash batchHash, CryptoHash.hash weight]

instance CryptoHash.Hashable Batch where
  hash batch = case batch of
    BatchOfBatches batchHashes ->
      CryptoHash.hashVariant "BatchOfBatches" [CryptoHash.hash batchHashes]
    BatchOfMintingAllowances mintingAllowances ->
      CryptoHash.hashVariant "BatchOfMintingAllowances" [CryptoHash.hash mintingAllowances]
    BatchOfWeightedBatches weightedRefs ->
      CryptoHash.hashVariant "BatchOfWeightedBatches" [CryptoHash.hash weightedRefs]

instance HasCheckedFetch CalculateRewardsV2 ForDso where
  contractGroupId CalculateRewardsV2 with .. = ForDso with ..

instance HasCheckedFetch ProcessRewardsV2 ForDso where
  contractGroupId ProcessRewardsV2 with .. = ForDso with ..
