-- | PoC (extension reward reporting): the full governance path for a registered synchronizer's
--   reported activity — register via vote, report as the operator, start reward processing via a
--   supermajority vote (`CRARC_StartProcessingExtensionRewardsV2`), and expand as the operator.
--
--   The reporting and expansion mechanics themselves (monotonicity, hash binding, authorization)
--   are exercised in the splice-amulet test package; this test proves the vote dispatch.
module Splice.Scripts.TestExtensionRewardVote where

import DA.Assert
import qualified DA.Set as Set
import DA.Time

import Daml.Script

import Splice.Amulet (RewardCouponV2(..))
import Splice.Amulet.CryptoHash qualified as CryptoHash
import Splice.Amulet.RewardAccountingV2
import Splice.AmuletRules
import Splice.DecentralizedSynchronizer
import Splice.DsoRules
import Splice.Types (Round(..))

import Splice.Scripts.DsoTestUtils

test_ExtensionRewards_viaVote : Script ()
test_ExtensionRewards_viaVote = do
  (app, dso, (sv1, sv2, sv3, sv4)) <- initMainNet

  operator <- allocateParty "dedicatedSyncOperator"
  featured <- allocateParty "featuredAppOnExtension"
  let dedicatedSyncId = "dedicated-sync::1220fefefefefefefefefefefefefefefefefefefefefefefefefefefefefefe"

  -- Rung 1: register the synchronizer via vote.
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $
    ARC_DsoRules with
      dsoAction = SRARC_RegisterSynchronizer DsoRules_RegisterSynchronizer with
        synchronizerId = dedicatedSyncId
        operator

  -- Reporting state (created directly as the DSO party in this PoC; production wiring of the
  -- state creation is part of the registration follow-ups).
  stateCid <- submit dso $ createCmd DedicatedSynchronizerState with
    dso
    synchronizerId = dedicatedSyncId
    operator
    lastReportedRound = None
    totalActivityReported = 0.0

  -- The operator reports a single-leaf tree of activity weights for round 1.
  let leaf = BatchOfMintingAllowances [MintingAllowance with provider = featured; amount = 25.0]
  result <- submit operator $ exerciseCmd stateCid DedicatedSynchronizerState_ReportActivity with
    round = Round 1
    activityRootHash = CryptoHash.hash leaf
    totalActivity = 25.0

  -- Supermajority vote to start reward processing for the report at a rate of 4 Amulet per unit.
  initiateAndAcceptVote app [sv1, sv2, sv3, sv4] $
    ARC_AmuletRules with
      amuletRulesAction = CRARC_StartProcessingExtensionRewardsV2 AmuletRules_StartProcessingExtensionRewardsV2 with
        reportCid = result.reportCid
        issuancePerActivityUnit = 4.0
        purchasedTotal = 1_000_000
        rewardCouponTimeToLive = days 30
        dryRun = False

  -- The operator expands its committed batch; the featured app's coupon carries weight * rate.
  [(prCid, pr)] <- query @ProcessRewardsV2 operator
  pr.expander === Some operator
  submit operator $ exerciseCmd prCid ProcessRewardsV2_ProcessBatch with
    batch = leaf
    providersWithWrongVettingState = Set.empty
  coupons <- query @RewardCouponV2 featured
  map (\(_, c) -> (c.provider, c.amount, c.round)) coupons === [(featured, 100.0, Round 1)]
